# Your running 9router instance, reachable from the ASTRO SERVER.
# The trailing /v1 is expected. Do not use a URL ending in /chat/completions.
NINEROUTER_BASE_URL=http://127.0.0.1:20128/v1

# Optional server-wide key fallback. Or enter a key inside the Mentora AI Settings panel.
# Never prefix server secrets with PUBLIC_.
NINEROUTER_API_KEY=

# Optional server-wide model fallback. Or select a model in the Mentora AI Settings panel.
# Use an available model ID from http://127.0.0.1:20128/v1/models.
# Model names depend on your configured 9router providers.
NINEROUTER_MODEL=

# Required for an internet-facing deployment: explicit allowed origins, comma-separated.
# Example: https://learn.example.com
ALLOWED_ORIGINS=http://localhost:4321,http://127.0.0.1:4321

# Optional: enabled by default. Disable only for your own closed, trusted local setup.
CHAT_RATE_LIMIT=20
