---
import { courses, totalLessons } from '../lib/courses.js';
import '../styles/global.css';
const { title = 'Learn AI engineering', description = 'A practical interview preparation academy for AI engineers.', activeCourse = '', activeLesson = '', eyebrow = 'THE AI ENGINEERING FIELD GUIDE' } = Astro.props;
const current = courses.find(c => c.slug === activeCourse);
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#000000" />
  <meta name="description" content={description} />
  <link rel="icon" type="image/svg+xml" href="/mentora-icon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900&family=Instrument+Serif:ital@1&display=swap" rel="stylesheet" />
  <title>{title} — Mentora</title>
</head>
<body style="background:#000;color:#fff" data-course={activeCourse} data-lesson={activeLesson}>
  <div class="mobile-scrim" id="mobile-scrim"></div>
  <div class="app-shell">
    <aside class="left-sidebar" aria-label="Course navigation">
      <a href="/" class="wordmark" aria-label="Mentora homepage">
        <svg class="wordmark-icon" viewBox="0 0 36 36" fill="none" aria-hidden="true"><path d="M7 25.5V10l11 12 11-12v15.5" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"/><circle cx="29" cy="8" r="2" fill="currentColor"/></svg>
        <span>mentora<span class="wordmark-suffix">.</span></span>
      </a>
      <div class="sidebar-overline">THE ENGINEERING LIBRARY</div>
      <nav class="primary-links" aria-label="Main">
        <a href="/academy/" class={activeCourse ? 'primary-link' : 'primary-link selected'}><span class="nav-symbol">⌑</span> Academy <span class="primary-tail">↗</span></a>
        <a href="/" class="primary-link"><span class="nav-symbol">⌂</span> Mentora homepage <span class="primary-tail">↗</span></a>
        <button type="button" class="primary-link search-open" aria-label="Search lessons"><span class="nav-symbol">⌕</span> Search library <kbd>⌘ K</kbd></button>
      </nav>
      <div class="nav-heading"><span>THE CURRICULUM</span><span>{courses.length} COURSES</span></div>
      <nav class="course-list" aria-label="Course and lesson navigation">
        {courses.map((course, index) => (
          <details
            class="course-group"
            data-course-slug={course.slug}
            open={activeCourse === course.slug || (!activeCourse && index === 0)}
          >
            <summary class:list={['course-link', 'course-toggle', activeCourse === course.slug && 'active']}>
              <span class="course-num">{course.number}</span>
              <span class="course-title">{course.title}</span>
              <span class="course-count">{course.lessons.length}</span>
              <svg class="course-chevron" aria-hidden="true" viewBox="0 0 16 16" fill="none"><path d="m5 6 3 3 3-3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </summary>
            <div class="course-sublist">
              <a
                href={`/course/${course.slug}/`}
                class:list={['course-overview-link', activeCourse === course.slug && !activeLesson && 'active']}
                aria-current={activeCourse === course.slug && !activeLesson ? 'page' : undefined}
              >Course overview <span aria-hidden="true">↗</span></a>
              {course.lessons.map(lesson => (
                <a
                  href={`/learn/${course.slug}/${lesson.id}/`}
                  class:list={['lesson-link', activeCourse === course.slug && String(activeLesson) === String(lesson.id) && 'active']}
                  aria-current={activeCourse === course.slug && String(activeLesson) === String(lesson.id) ? 'page' : undefined}
                  data-progress-key={`${course.slug}:${lesson.id}`}
                >
                  <span class="lesson-nav-num">{String(lesson.id).padStart(2, '0')}</span>
                  <span class="lesson-nav-title">{lesson.title}</span>
                  <span class="lesson-completion-indicator" aria-label="Not completed">○</span>
                </a>
              ))}
            </div>
          </details>
        ))}
      </nav>
      <div class="sidebar-bottom">
        <div class="sidebar-progress"><div class="sidebar-progress-top"><span>YOUR PROGRESS</span><span id="progress-count">0 / {totalLessons}</span></div><div class="track"><div id="global-progress" class="track-fill"></div></div><small>Progress saved locally on this device</small><small id="progress-feedback" role="status" aria-live="polite"></small></div>
        <a class="sidebar-archive" href={current ? `/course/${current.slug}/` : "/academy/"}>↗ &nbsp; Explore Mentora lessons</a>
      </div>
    </aside>
    <div class="main-panel">
      <header class="topbar">
        <button class="icon-button menu-toggle" type="button" aria-label="Open course navigation" aria-expanded="false">☰</button>
        <div class="topbar-location"><span class="tiny-star">✦</span><span class="topbar-course">{current ? current.title : 'Mentora Academy'}</span><span class="topbar-separator">/</span><span class="topbar-muted">{eyebrow}</span></div>
        <div class="topbar-actions"><span class="topbar-hint">BUILT FOR DEEP LEARNING</span><button type="button" class="icon-button search-open" aria-label="Search courses">⌕</button><button type="button" class="icon-button tutor-toggle" aria-label="Toggle AI tutor" aria-expanded="false">✧</button></div>
      </header>
      <main class="main-scroll" id="main-content"><slot /></main>
    </div>
    <aside class="tutor-panel" id="tutor-panel" aria-label="Mentora AI chatbot">
      <div class="tutor-header"><div class="tutor-logo">✧</div><div class="tutor-heading"><strong>Mentora AI</strong><small>PAGE-AWARE ASSISTANT · 9ROUTER</small></div><button class="tutor-settings-toggle" id="tutor-settings-toggle" type="button" aria-label="AI settings" title="AI settings" aria-controls="tutor-settings" aria-expanded="false"><svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" stroke-linecap="round" aria-hidden="true"><path d="M12 3.2 14 4l2-.5 1.7 1.7-.5 2L18 9l2.1.8v2.4L18 13l-.8 1.8.5 2-1.7 1.7-2-.5-2 .8-2-.8-2 .5-1.7-1.7.5-2L6 13l-2.1-.8V9.8L6 9l.8-1.8-.5-2L8 3.5l2 .5 2-.8Z"/><circle cx="12" cy="11" r="3"/></svg></button><button class="tutor-close" type="button" aria-label="Close tutor">×</button></div>
      <div class="tutor-status"><span id="tutor-dot" class="status-dot"></span><span id="tutor-status-text">Set up 9Router in Settings</span><span class="tutor-context">{activeLesson ? 'LESSON-AWARE' : 'COURSE-AWARE'}</span></div>
      <section id="tutor-settings" class="tutor-settings" aria-label="9Router settings" hidden>
        <div class="tutor-settings-head"><strong>AI settings</strong><span>9ROUTER</span></div>
        <p>Connect your 9Router account and choose the model that answers questions about this page.</p>
        <form id="tutor-settings-form" autocomplete="off">
          <label for="settings-api-key">API key</label>
          <div class="settings-secret"><input id="settings-api-key" type="password" autocomplete="off" placeholder="Paste your 9Router key" spellcheck="false"/><button type="button" id="settings-reveal" aria-label="Show API key" aria-pressed="false">Show</button></div>
          <span class="settings-help">Sent to the Mentora server for 9Router requests. A server key, if configured, is used when blank.</span>
          <label class="settings-remember"><input id="settings-remember-key" type="checkbox" checked />Remember API key on this device</label>
          <span class="settings-help">Stored in this browser until cleared. Avoid this option on shared devices; site scripts can access stored keys.</span>
          <div class="settings-model-label"><label for="settings-model">Model</label><button id="settings-refresh-models" type="button">↻ Load models</button></div>
          <select id="settings-model" aria-label="9Router model"><option value="">Choose a model</option><option value="__custom__">Enter a model ID…</option></select>
          <input id="settings-custom-model" type="text" maxlength="160" spellcheck="false" placeholder="e.g. provider/model-name" aria-label="Custom 9Router model ID" hidden />
          <p class="settings-feedback" id="settings-feedback" role="status" aria-live="polite"></p>
          <div class="settings-actions"><button type="button" id="settings-clear">Clear saved key</button><button class="settings-save" type="submit">Save settings</button></div>
        </form>
      </section>
      <div class="tutor-thread" id="tutor-thread" role="log" aria-live="polite">
        <div class="tutor-intro"><div class="intro-orbit"><span>✧</span></div><p class="intro-eyebrow">YOUR PERSONAL STUDY PARTNER</p><h2>Think deeper.<br/><em>Ask anything.</em></h2><p>Confused by a concept? Ask a question and get an explanation grounded in the page you’re reading.</p></div>
        <div class="suggestions" id="suggestions">
          <button type="button" data-suggestion="Explain the main concept on this page in simple words with an example."><span>01</span> Explain simply <b>↗</b></button>
          <button type="button" data-suggestion="Explain this topic step by step, including why it works."><span>02</span> Walk me through it <b>↗</b></button>
          <button type="button" data-suggestion="Give me a real-world example of the concept explained on this page."><span>03</span> Real-world example <b>↗</b></button>
        </div>
      </div>
      <form class="tutor-form" id="tutor-form">
        <div class="tutor-selection" id="tutor-selection" hidden>
          <div class="tutor-selection-top"><span>SELECTED FROM THIS PAGE</span><button type="button" id="tutor-selection-clear" aria-label="Remove selected text" title="Remove selection">×</button></div>
          <blockquote id="tutor-selection-text"></blockquote>
        </div>
        <div class="composer"><textarea id="tutor-input" rows="2" aria-label="Ask the AI tutor" placeholder="What would you like clarified?" maxlength="2000"></textarea><div class="composer-bottom"><span>ENTER TO SEND · SHIFT + ENTER FOR LINE</span><div class="composer-controls"><button class="stop-button" type="button" id="stop-chat" hidden>Stop</button><button class="send-button" id="send-chat" type="submit" aria-label="Send message">↑</button></div></div></div><div class="tutor-footnote">Answers can be incorrect. Verify important details.</div></form>
    </aside>
  </div>
  <button id="selection-ask" class="selection-ask" type="button" aria-label="Ask Mentora about selected text" hidden><span aria-hidden="true">✧</span> Ask Mentora <span aria-hidden="true">↗</span></button>
  <div class="search-modal" id="search-modal" hidden role="dialog" aria-modal="true" aria-label="Search curriculum"><div class="search-dialog"><div class="search-box"><span>⌕</span><input id="search-input" placeholder="Search 234 lessons, topics, concepts..." aria-label="Search query" autocomplete="off"/><button class="search-dismiss" type="button">ESC</button></div><div class="search-results" id="search-results"></div><div class="search-footer">SEARCH ALL COURSES <span>↵ TO OPEN · ESC TO CLOSE</span></div></div></div>
  <script src="/app.js" is:inline defer></script>
</body>
</html>
